rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_stores/{email} {
      allow read, write: if request.auth != null || true;
    }
    match /otp_codes/{email} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
